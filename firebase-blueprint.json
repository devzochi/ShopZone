{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data and role permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "address": {
          "type": "object",
          "properties": {
            "fullName": { "type": "string" },
            "street": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "zip": { "type": "string" }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Store inventory products catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "image": { "type": "string" },
        "gallery": { "type": "array", "items": { "type": "string" } },
        "badge": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "type": { "type": "string" }
          }
        },
        "description": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "colors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "hex": { "type": "string" }
            }
          }
        },
        "inStock": { "type": "boolean" },
        "isTrending": { "type": "boolean" },
        "isDeal": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "price", "image", "description", "inStock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string" },
        "shippingAddress": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerEmail", "items", "totalAmount", "status", "createdAt"]
    }
  },
  "firestore": {
    "collections": {
      "users": {
        "entity": "User",
        "description": "User profiles indexed by UID"
      },
      "products": {
        "entity": "Product",
        "description": "CommerceOS product catalog"
      },
      "orders": {
        "entity": "Order",
        "description": "Placed store orders"
      },
      "carts": {
        "description": "Persistent user cart documents"
      },
      "wishlists": {
        "description": "Persistent user wishlist documents"
      }
    }
  }
}
